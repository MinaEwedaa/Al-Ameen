                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"عبد الرحمن بن خلدون المصري\",\n  \"phone\": \"+201099887766\",\n  \"id_number\": \"29510101234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/guests",
              "host": ["{{baseUrl}}"],
              "path": ["guests"]
            }
          }
        },
        {
          "name": "Create Reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
