    {
      "name": "1. Authentication & Shift",
      "item": [
        {
          "name": "Receptionist Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.environment.set('token', res.access_token);",
                  "}",
                  "if (res.shift && res.shift.shift_id) {",
                  "  pm.environment.set('shiftId', res.shift.shift_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sec_receptionist\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Active Shift",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/shifts/current",
              "host": ["{{baseUrl}}"],
              "path": ["shifts", "current"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Rooms & Availability",
      "item": [
        {
          "name": "List All Rooms",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "  pm.environment.set('roomId', res.data[0].room_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            }
          }
        },
        {
          "name": "Check Availability",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms/availability?check_in=2026-10-18T12:00:00.000Z&check_out=2026-10-20T12:00:00.000Z",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "availability"],
              "query": [
                { "key": "check_in", "value": "2026-10-18T12:00:00.000Z" },
                { "key": "check_out", "value": "2026-10-20T12:00:00.000Z" }
              ]
            }
          }
        }
      ]
    },
    {
