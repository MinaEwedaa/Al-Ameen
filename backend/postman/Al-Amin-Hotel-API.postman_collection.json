            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservation_id\": \"{{reservationId}}\",\n  \"amount\": 1000,\n  \"payment_method\": \"cash\",\n  \"notes\": \"عربون حجز\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
